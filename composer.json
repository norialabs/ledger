{
    "name": "norialabs/ledger",
    "description": "Exact, immutable, multi-entity accounting for Laravel applications and accounting practices.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "accounting",
        "double-entry",
        "ledger",
        "multi-currency"
    ],
    "require": {
        "php": "^8.3",
        "ext-dom": "*",
        "ext-pdo": "*",
        "ext-pdo_pgsql": "*",
        "brick/math": "^0.19",
        "brick/money": "^0.15",
        "illuminate/database": "^13.0",
        "illuminate/http": "^13.0",
        "illuminate/support": "^13.0",
        "spatie/simple-excel": "^3.11"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.20",
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^4.0|^5.0",
        "pestphp/pest-plugin-type-coverage": "^4.0|^5.0"
    },
    "autoload": {
        "psr-4": {
            "Noria\\Ledger\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Noria\\Ledger\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Noria\\Ledger\\LedgerServiceProvider"
            ]
        }
    },
    "scripts": {
        "post-install-cmd": [
            "@hooks"
        ],
        "post-update-cmd": [
            "@hooks"
        ],
        "hooks": "git rev-parse --git-dir >/dev/null 2>&1 && git config core.hooksPath .githooks || true",
        "lint": "@php vendor/bin/pint --test",
        "analyse": "@php vendor/bin/phpstan analyse --no-progress --memory-limit=2G",
        "types": "@php vendor/bin/pest --type-coverage --min=100",
        "test": [
            "@putenv XDEBUG_MODE=coverage",
            "@php vendor/bin/pest --coverage --min=90"
        ],
        "check": [
            "@lint",
            "@analyse",
            "@types",
            "@test"
        ]
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "archive": {
        "exclude": [
            "/vendor",
            "/.git",
            "/tests",
            "/.github",
            "/.phpunit.cache",
            "/.phpstan.cache",
            "/composer.lock",
            "/.phpactor.json",
            "/.env",
            "/.DS_Store",
            "/phpstan.neon",
            "/phpunit.xml"
        ]
    }
}
