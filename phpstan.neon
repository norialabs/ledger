includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    level: max
    paths:
        - src
        - database
        - tests
    tmpDir: .phpstan.cache
    treatPhpDocTypesAsCertain: false

services:
    -
        class: Noria\Ledger\Tests\Support\PestClosureThis
        tags:
            - phpstan.functionParameterClosureThisExtension
